{
  "name": "capture-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "package:extension": "pnpm --filter @capture-kit/extension build && tsx scripts/package-extension.ts",
    "test": "tsx packages/model/test.ts",
    "test:serializer": "tsx packages/serializer/test.ts",
    "test:sketch": "tsx scripts/verify-sketch.ts && tsx packages/destinations/sketch/test.ts",
    "test:figma": "tsx packages/destinations/figma/test.ts",
    "test:html": "tsx packages/destinations/html/test.ts",
    "test:diff": "tsx tools/diff/test.ts",
    "fidelity": "tsx tools/fidelity/run.ts",
    "fidelity:suite": "tsx tools/fidelity/run.ts --suite",
    "test:fidelity": "tsx tools/fidelity/test.ts",
    "test:fidelity:cli": "tsx tools/fidelity/cli.test.ts",
    "test:markdown": "tsx packages/destinations/markdown/test.ts",
    "test:react": "tsx packages/destinations/react/test.ts",
    "test:extension": "tsx apps/extension/test.ts",
    "fidelity:replica": "node tools/fidelity/replica.ts"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "playwright-core": "^1.65.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "zod": "^4.6.7"
  }
}

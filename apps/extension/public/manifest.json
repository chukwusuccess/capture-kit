{
  "manifest_version": 3,
  "name": "capture-kit",
  "version": "0.2.2",
  "description": "Capture a page or every page of a site into a neutral model; export to Figma, Sketch, SVG, HTML.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Pick an element on the page and copy to Figma/Sketch"
    },
    "copy-page": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Copy current page to Figma/Sketch clipboard"
    }
  }
}

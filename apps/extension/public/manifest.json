{
  "manifest_version": 3,
  "name": "capture-kit",
  "version": "0.2.1",
  "description": "Capture a page or every page of a site into a neutral model; export to Figma, Sketch, SVG, HTML.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
